<?xml version="1.0"?>
<robot name="rbwatcher_xl" xmlns:xacro="http://wiki.ros.org/xacro">


	<!-- ***************** -->
	<!-- 
	RB-WATCHER-XL     
	
	This model includes: 
	- RB-WATCHER-XL base 
	- Link-750 camera 
	- RS-HELIOS-16P 
	- Vectornav 
	- Intel d435f
	- Axis 360 camera ring
	-->

	<!-- First we import all posible elements defined in the urdf.xacro files. All these elements are defined as macro:xacros -->

	<!-- Import summit XL base elements -->
	<xacro:include filename="$(find robot_description)/urdf/bases/rbwatcher_xl_base.urdf.xacro" />
	<xacro:include filename="$(find robot_description)/urdf/structures/rbwatcher_xl/rbwatcher_xl_structure.xacro" />
	<xacro:include filename="$(find robot_description)/urdf/structures/sensor_support/antena_std.urdf.xacro" />


	<!-- Import all available sensors -->
	<xacro:include filename="$(find robotnik_sensors)/urdf/all_sensors.urdf.xacro" />


	<!-- Flag to select the high or low quality model -->
	<xacro:arg name="prefix" default="robot_"/>
	<xacro:arg name="ros_planar_move_plugin" default="false"/>
    <xacro:arg name="ros_planar_move_plugin_force_based" default="false"/>
	<xacro:arg name="kinematics" default="skid"/>
	<xacro:arg name="gpu" default="false"/>
	<xacro:arg name="gps_latitude" default="0"/>
	<xacro:arg name="gps_longitude" default="0"/>
	<xacro:arg name="sim_control_period" default="0.004"/>


    <xacro:macro name="rbwatcher_xl" params="prefix publish_bf hq kinematics:=skid">
		<xacro:property name="top_structure_mesh" value="robot_description/meshes/structures/rbwatcher_xl/rbwatcher_xl_top_structure" />
		<xacro:property name="top_structure_x" value="-0.32363"/>
		<xacro:property name="top_structure_y" value="0"/>
		<xacro:property name="top_structure_z" value="0.26135"/>
		<xacro:property name="PI" value="3.1415926535897931"/>


		<!-- *************** -->
		<!-- Robots Elements -->
		<!-- *************** -->

		<!-- Here we create the robot elements using the xacro:macros imported at the beggining of this file -->

		<!-- RBWatcher XL base -->
		<xacro:rbwatcher_xl_base prefix="${prefix}" publish_bf="true" hq="${hq}" />
		
		<xacro:rbwatcher_xl_structure prefix="${prefix}top_structure" parent="${prefix}base_link" mesh_file="${top_structure_mesh}" >
			<origin xyz="${top_structure_x} ${top_structure_y} ${top_structure_z}" rpy="0 0 0"/>
		</xacro:rbwatcher_xl_structure>

    	<!-- IMU -->
    	<xacro:sensor_imu prefix="${prefix}imu" parent="${prefix}base_link" topic="imu/data">
    	  	<origin xyz="-0.03534 0.132 0.16109" rpy="0 0 0"/>
    	</xacro:sensor_imu>
    	
    	<!-- RGBD -->
    	<xacro:sensor_intel_d435 prefix="${prefix}front_rgbd_camera" parent="${prefix}base_link" prefix_topic="front_rgbd_camera">
			<origin xyz="0.29995 0.0 0.20261" rpy="0 0 0"/>
    	</xacro:sensor_intel_d435>

        <!-- GPS -->
        <xacro:sensor_ublox prefix="${prefix}gps" parent="${prefix}base_link" use_mast="false">
            <origin xyz="-0.26135 0.249 0.81463" rpy="0 0 0"/>
        </xacro:sensor_ublox>

    	<!-- LIDAR -->
    	<xacro:sensor_rs_helios_16p prefix="${prefix}top_3d_laser" prefix_topic="top_3d_laser" parent="${prefix}base_link" gpu="$(arg gpu)" suffix_topic="_raw">
    	  	<origin xyz="0.0 0.0 0.43163" rpy="0 0 0"/>
    	</xacro:sensor_rs_helios_16p>

		<!-- Antenna -->
		<xacro:sensor_antena_std prefix="${prefix}antenna" parent="${prefix}base_link">
			<origin xyz="-0.200 0.0 0.32613" rpy="0 0 0"/>
		</xacro:sensor_antena_std>

		<!-- Axis 360 camera ring -->
		<xacro:sensor_axis_360_camera_ring prefix="${prefix}top_camera_ring" parent="${prefix}base_link" prefix_topic="top_camera_ring">
			<origin xyz="-0.05575 0 0.65963" rpy="0 0 0"/>
		</xacro:sensor_axis_360_camera_ring>

		<!-- PTZ camera -->
		<xacro:sensor_link_750_nh prefix="${prefix}top_ptz_camera" prefix_topic="top_ptz_camera" parent="${prefix}base_link" fps="15.0">
			<origin xyz="-0.05575 0 0.73813" rpy="0 0 0"/>
		</xacro:sensor_link_750_nh>

		<!-- Gazebo ros control pluggins -->
		<xacro:ros_control control_period="$(arg sim_control_period)"/>

		<xacro:if value="$(arg ros_planar_move_plugin)">

			<xacro:skid_steering prefix="${prefix}" publish_tf="true" force_based="$(arg ros_planar_move_plugin_force_based)"/>

		</xacro:if>

   </xacro:macro>

   <xacro:rbwatcher prefix="$(arg prefix)" publish_bf="true" hq="true" kinematics="$(arg kinematics)"/>


</robot>